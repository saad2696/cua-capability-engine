{
  "name": "cua-capability-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation: an LLM discovers a UI flow once, records it as a typed capability artifact, and deterministic replay runs it on demand with human escalation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/cli' --filter './apps/target-app' typecheck",
    "dev:target": "pnpm --filter @cua/target-app dev",
    "dev:console": "pnpm --filter @cua/operator-console dev",
    "cua": "tsx apps/cli/src/main.ts",
    "serve": "tsx apps/cli/src/main.ts serve",
    "demo:handover": "node scripts/demo-handover.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4",
    "tsx": "^4.20.3"
  },
  "packageManager": "pnpm@11.3.0"
}
