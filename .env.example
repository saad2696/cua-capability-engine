# --- Target app (mock Legacy CU Core) ---
TARGET_APP_URL=http://localhost:4100
TARGET_USER=demo
TARGET_PASSWORD=demo

# --- Engine ---
CUA_HEADLESS=true                  # set false to watch the browser
CUA_SERVER_PORT=4200
CUA_EVIDENCE_DIR=./evidence
